// OmaBackups (BUILD 5.2, D27): members of the omabackups group (the one user
// linked at setup), in an active local session, may start and stop
// OmaBackups' own root jobs without a password. Nothing else.
polkit.addRule(function (action, subject) {
  if (action.id !== "org.freedesktop.systemd1.manage-units") return;
  if (!subject.isInGroup("omabackups") || !subject.local || !subject.active) return;
  var verb = action.lookup("verb");
  if (verb !== "start" && verb !== "stop") return;
  var unit = action.lookup("unit");
  if (/^omabackups-root@[a-z][a-z-]{0,40}\.service$/.test(unit)) return polkit.Result.YES;
});
