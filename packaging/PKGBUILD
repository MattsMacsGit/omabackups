# The omabackups package (D20).
# This build reads the files from the repo it sits in (for testing):
#   cd packaging && makepkg -sif   (-f: always build fresh; the version only changes at release)
# The AUR version (at release) downloads a tagged, checked release instead.

pkgname=omabackups
pkgver=2.0.0.dev1
pkgrel=1
pkgdesc="Backups, rescue and migration for Omarchy"
arch=(any)
url="https://github.com/MattsMacsGit/omabackups"
license=(MIT)
depends=(python rsync openssh cryptsetup btrfs-progs polkit)
optdepends=('tailscale: back up when away from home')

package() {
  local repo="$startdir/.."
  local site
  site="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"

  # The omabackups command's code, compiled ahead so it starts fast.
  cd "$repo/src"
  find omabackups -name '*.py' -exec install -Dm644 {} "$pkgdir$site/{}" \;
  python -m compileall -q -s "$pkgdir" -p / "$pkgdir$site/omabackups"

  # The command itself.
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/omabackups" <<'EOF'
#!/usr/bin/python3
import sys
from omabackups.cli import main
sys.exit(main())
EOF

  # The gatekeeper, packed into one file that setup copies to backup servers.
  python "$repo/packaging/pack-gate.py" "$repo/server/gate" "$pkgdir/usr/share/omabackups/gate.pyz"

  # The root helper (5.2, D27): its unit, the link pop-up and its folders.
  local files="$repo/packaging/files"
  install -Dm644 "$files/omabackups-root@.service" "$pkgdir/usr/lib/systemd/system/omabackups-root@.service"
  install -Dm644 "$files/omabackups-backup@.service" "$pkgdir/usr/lib/systemd/system/omabackups-backup@.service"
  install -Dm644 "$files/omabackups-backup.timer" "$pkgdir/usr/lib/systemd/system/omabackups-backup.timer"
  install -Dm644 "$files/omabackups-health.service" "$pkgdir/usr/lib/systemd/system/omabackups-health.service"
  install -Dm644 "$files/omabackups-health.timer" "$pkgdir/usr/lib/systemd/system/omabackups-health.timer"
  install -Dm644 "$files/org.omabackups.link.policy" "$pkgdir/usr/share/polkit-1/actions/org.omabackups.link.policy"
  install -Dm644 "$files/omabackups.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/omabackups.conf"
  install -Dm644 "$files/99-omabackups.rules" "$pkgdir/usr/lib/udev/rules.d/99-omabackups.rules"

  install -Dm644 "$repo/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
